<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示词小精灵" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" Topmost="True" AllowDrop="True" UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="#211831" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#211831"/>
    <SolidColorBrush x:Key="Muted" Color="#655D74"/>
    <SolidColorBrush x:Key="Line" Color="#E9DFF1"/>
    <SolidColorBrush x:Key="Paper" Color="#FAF7FC"/>
    <LinearGradientBrush x:Key="Night" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#211733" Offset="0"/>
      <GradientStop Color="#302045" Offset=".58"/>
      <GradientStop Color="#4C326C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Primary" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#7750BE" Offset="0"/>
      <GradientStop Color="#5D398E" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="MascotGlow" Center="0.48,0.46" GradientOrigin="0.48,0.46" RadiusX=".55" RadiusY=".55">
      <GradientStop Color="#79BE8CFF" Offset="0"/>
      <GradientStop Color="#42744FBA" Offset=".60"/>
      <GradientStop Color="#00744FBA" Offset="1"/>
    </RadialGradientBrush>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#F1EAF8"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" CornerRadius="10" BorderThickness="1.5"
                    BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#A992CD"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value=".78"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#7955BB"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value=".50"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="SelectionBrush" Value="#CBAEF3"/>
      <Setter Property="CaretBrush" Value="#6945AB"/>
    </Style>
  </Window.Resources>

  <Border x:Name="Shell" Width="108" CornerRadius="27" BorderThickness="1" BorderBrush="#705486"
          Background="{StaticResource Night}" Padding="0">
    <StackPanel>
      <Grid x:Name="Handle" Height="124" Background="Transparent" Cursor="SizeAll" Focusable="True"
            ToolTip="拖动小精灵，点击展开或收起" AutomationProperties.Name="小精灵，按 Enter 展开或收起">
        <Grid x:Name="Heading" Visibility="Collapsed" Margin="23,0,120,0" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="提示词小精灵" Foreground="#FFF8FF" FontSize="26" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
              <Ellipse Width="5" Height="5" Fill="#E5B5FC" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock Text="由 Codex 生成" Foreground="#E1D1EB" FontSize="12"/>
            </StackPanel>
          </StackPanel>
        </Grid>
        <Grid x:Name="Mascot" Width="94" Height="88" HorizontalAlignment="Center" VerticalAlignment="Top"
              Margin="0,3,0,0" IsHitTestVisible="False">
          <Ellipse Width="91" Height="83" Fill="{StaticResource MascotGlow}" Margin="0,0,0,3"/>
          <Ellipse Width="73" Height="58" Margin="0,1,0,0" Stroke="#73BDA1E0" StrokeThickness="0.9">
            <Ellipse.RenderTransform><RotateTransform Angle="-23" CenterX="36.5" CenterY="29"/></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse Width="3" Height="3" Fill="#D7BBF7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="17,0,0,16"/>
          <Ellipse Width="2.5" Height="2.5" Fill="#F6C88D" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,10,0"/>
          <Viewbox Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
            <Viewbox.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1"/>
                <RotateTransform x:Name="PetTilt"/>
              </TransformGroup>
            </Viewbox.RenderTransform>
            <Canvas Width="100" Height="86">
              <Image Width="100" Height="86" Stretch="Uniform">
                <Image.Source>
                  <DrawingImage>
                    <DrawingImage.Drawing>
                      <DrawingGroup>
                        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H100 V86 H0 Z"/>
                        <GeometryDrawing Brush="#3E315A" Geometry="M54,70 A12,2.4 0 1 1 54,75 A12,2.4 0 1 1 54,70 Z"/>
                        <GeometryDrawing Geometry="M34,54 C29,42 34,24 48,20 C61,16 72,24 73,37 C74,44 72,49 77,54 C80,57 75,62 70,59 C65,64 60,62 56,59 C51,64 45,64 41,59 C36,63 31,59 34,54 Z">
                          <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.9,1">
                              <GradientStop Color="#FFF7FF" Offset="0"/>
                              <GradientStop Color="#E8CEF9" Offset=".57"/>
                              <GradientStop Color="#BB8EEB" Offset="1"/>
                            </LinearGradientBrush>
                          </GeometryDrawing.Brush>
                          <GeometryDrawing.Pen><Pen Brush="#FAF2FF" Thickness="1"/></GeometryDrawing.Pen>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#EBA9DF"><GeometryDrawing.Geometry><GeometryGroup>
                          <EllipseGeometry Center="40,50" RadiusX="3.3" RadiusY="2"/><EllipseGeometry Center="67,50" RadiusX="3.3" RadiusY="2"/>
                        </GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                        <GeometryDrawing Geometry="M51,49 Q54,52 57,49"><GeometryDrawing.Pen><Pen Brush="#54376B" Thickness="1.5" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen></GeometryDrawing>
                        <GeometryDrawing Brush="#FCD58E" Geometry="M77,13 Q79,19 85,20 Q79,22 77,28 Q76,22 70,20 Q76,19 77,13 Z"/>
                        <GeometryDrawing Brush="#DDC8FF" Geometry="M26,27 Q27,31 31,32 Q27,33 26,37 Q25,33 21,32 Q25,31 26,27 Z"/>
                      </DrawingGroup>
                    </DrawingImage.Drawing>
                  </DrawingImage>
                </Image.Source>
              </Image>
              <Canvas Width="100" Height="86">
                <Canvas.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform x:Name="EyeLids" ScaleX="1" ScaleY="1" CenterY="43"/>
                  </TransformGroup>
                </Canvas.RenderTransform>
                <Ellipse Canvas.Left="43.2" Canvas.Top="38.6" Width="5.6" Height="8.8" Fill="#34263E"/>
                <Ellipse Canvas.Left="58.2" Canvas.Top="38.6" Width="5.6" Height="8.8" Fill="#34263E"/>
              </Canvas>
            </Canvas>
          </Viewbox>
          <Border x:Name="Badge" Width="11" Height="11" Margin="0,9,13,0" CornerRadius="6"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Background="#A2F4D8" BorderBrush="#382C54"
                  BorderThickness="2" Visibility="Collapsed"/>
        </Grid>
        <TextBlock x:Name="CompactName" Text="提示词小精灵" Foreground="#F5ECFF" FontWeight="Bold"
                   FontSize="13" MaxWidth="96" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"/>
        <TextBlock x:Name="Caption" Text="拖入素材" Foreground="#E4CFEF" FontWeight="Normal"
                   FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
      </Grid>

      <Border x:Name="Details" Background="{StaticResource Paper}" CornerRadius="0,0,25,25" Visibility="Collapsed">
        <StackPanel Margin="19,17,19,11">
          <Border x:Name="DropSurface" CornerRadius="16" BorderThickness="1.5" BorderBrush="#E1D2ED">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFFFF" Offset="0"/>
                <GradientStop Color="#F5EEFA" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="12,10,12,11">
              <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Width="30" Height="30" Background="#F0E6F9" CornerRadius="9" Margin="0,0,8,0">
                  <Path Data="M 12,3 L 12,14 M 8,10 L 12,14 L 16,10 M 5,15 V19 H19 V15"
                        Stroke="#784BA3" StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button x:Name="Browse" DockPanel.Dock="Right" Content="选择文件" Margin="6,0,0,0" Padding="8,5"
                        Background="#FFFFFF" BorderBrush="#E6DCF4" MinHeight="32"/>
                <Button x:Name="CaptureRegion" DockPanel.Dock="Right" Margin="7,0,0,0" Padding="8,5"
                        Background="#F0E5FA" BorderBrush="#E9DAF5" AutomationProperties.Name="录屏"
                        ToolTip="录制选定区域的视频画面" MinHeight="32">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="#B7516B" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="录屏"/>
                  </StackPanel>
                </Button>
                <TextBlock x:Name="Source" Text="拖入图片、视频或文本" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{StaticResource Ink}" FontWeight="SemiBold"/>
              </DockPanel>
              <Border Background="#FFFFFF" CornerRadius="10" Margin="0,10,0,0" BorderThickness="1" BorderBrush="#EADFF0">
                <Grid>
                  <Path Data="M7,11 L10,8 M9,6 L12,3 A3,3 0 0 1 16,7 L13,10 M8,9 L5,12 A3,3 0 0 1 1,8 L4,5"
                        Stroke="#997CAA" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                  <TextBox x:Name="Input" Height="36" Padding="30,0,9,0" VerticalContentAlignment="Center"
                           AutomationProperties.Name="粘贴链接或参考文本" AllowDrop="True"/>
                  <TextBlock Text="粘贴链接或参考文本" Foreground="{StaticResource Muted}" Margin="30,0,10,0"
                             IsHitTestVisible="False" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <DockPanel LastChildFill="True" Margin="0,11,0,0">
            <Button x:Name="Generate" DockPanel.Dock="Right" Width="142" MinHeight="42" AutomationProperties.Name="生成提示词"
                    Background="{StaticResource Primary}" Foreground="White" Margin="9,0,0,0">
              <StackPanel Orientation="Horizontal">
                <Path Data="M8,1 Q9,7 15,8 Q9,9 8,15 Q7,9 1,8 Q7,7 8,1 Z" Fill="#F3DDF8"
                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock Text="生成提示词" FontWeight="Bold"/>
              </StackPanel>
            </Button>
            <ComboBox x:Name="Mode" SelectedIndex="0" MinHeight="42" Padding="10,5"
                      AutomationProperties.Name="提示词类型" BorderBrush="#DCD2E8" Background="#FFFFFF">
              <ComboBox.Template>
                <ControlTemplate TargetType="ComboBox">
                  <Grid>
                    <ToggleButton x:Name="ModeToggle" Focusable="False" Cursor="Hand"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                          <Border x:Name="ModeSurface" CornerRadius="11" Background="White" BorderThickness="1" BorderBrush="#DCD2E8">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="ModeSurface" Property="BorderBrush" Value="#A992CD"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="ModeSurface" Property="BorderBrush" Value="#7955BB"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </ToggleButton.Template>
                      <Grid Margin="12,0">
                        <Path Data="M 0,0 L 4,4 L 8,0" Stroke="#655D74" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                      </Grid>
                    </ToggleButton>
                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="12,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <Border x:Name="ModeFocus" BorderThickness="2" CornerRadius="11" IsHitTestVisible="False" BorderBrush="Transparent"/>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                           AllowsTransparency="True" PlacementTarget="{Binding ElementName=ModeToggle}">
                      <Border CornerRadius="11" Padding="4" Margin="0,3,0,0" Background="White" BorderBrush="#DCD2E8" BorderThickness="1"
                              MinWidth="{Binding ActualWidth, ElementName=ModeToggle}">
                        <ScrollViewer CanContentScroll="True" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                          <ItemsPresenter/>
                        </ScrollViewer>
                      </Border>
                    </Popup>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                      <Setter TargetName="ModeFocus" Property="BorderBrush" Value="#7955BB"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ComboBox.Template>
              <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                  <Setter Property="Padding" Value="9,7"/>
                  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="#F1EBFA"/>
                          </Trigger>
                          <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="#E9DEF9"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ComboBox.ItemContainerStyle>
              <ComboBoxItem Content="自动判断类型"/>
              <ComboBoxItem Content="图像提示词"/>
              <ComboBoxItem Content="视频提示词"/>
              <ComboBoxItem Content="网页实现提示词"/>
            </ComboBox>
          </DockPanel>
          <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="2,7,2,0"
                     AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <StackPanel x:Name="LinkFallback" Orientation="Horizontal" Visibility="Collapsed" Margin="0,6,0,0">
            <Button x:Name="OpenSource" Content="在小精灵里打开抖音" MinHeight="30" Padding="8,4"/>
            <Button x:Name="PasteImage" Content="粘贴截图" MinHeight="30" Padding="8,4" Margin="7,0,0,0"
                    ToolTip="按 Win + Shift + S 截取视频画面，再点这里"/>
          </StackPanel>

          <Border CornerRadius="16" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="#FFFFFF" Margin="0,13,0,0">
            <StackPanel>
              <DockPanel LastChildFill="True" Margin="12,8,9,7">
                <Button x:Name="Copy" DockPanel.Dock="Right" IsEnabled="False" Padding="9,4" MinHeight="32"
                        AutomationProperties.Name="复制提示词">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="M 5,4 H 13 V 14 H5 Z M 3,11 H 1 V1 H9 V2" Stroke="#7B51A1" StrokeThickness="1.35"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="12" Height="12"
                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="复制提示词"/>
                  </StackPanel>
                </Button>
                <TextBlock Text="提示词" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
              </DockPanel>
              <Border Height="1" Background="#EFE8F2" Margin="11,0"/>
              <Grid>
                <TextBox x:Name="Output" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Height="157" Padding="12,10" FontSize="13" AutomationProperties.Name="生成的提示词"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=Output}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <Border Width="37" Height="37" CornerRadius="11" Background="#F5EFF9" HorizontalAlignment="Center">
                    <Path Data="M4,1 H12 L17,6 V19 H4 Z M12,1 V6 H17 M7,10 H14 M7,14 H12" Stroke="#9C75B8"
                          StrokeThickness="1.45" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="17" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="生成后，提示词会出现在这里" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <DockPanel LastChildFill="False" Margin="0,9,0,0">
            <Button x:Name="Settings" DockPanel.Dock="Left" Content="登录 Codex" Background="Transparent" Padding="6,4" MinHeight="30"/>
            <Button x:Name="Browser" DockPanel.Dock="Left" Content="内置浏览器" Background="Transparent" Padding="7,4" MinHeight="30" Margin="4,0,0,0"/>
            <Button x:Name="Quit" DockPanel.Dock="Right" Content="退出" Foreground="{StaticResource Muted}" Background="Transparent" Padding="7,4" MinHeight="30"/>
            <Button x:Name="Collapse" DockPanel.Dock="Right" Content="收起" Foreground="{StaticResource Muted}" Background="Transparent" Padding="7,4" MinHeight="30"/>
          </DockPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Window>
